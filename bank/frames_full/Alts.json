          {
            "name": "Contango and backwardation",
            "children": [
              {
                "name": "Contango",
                "children": [
                  { "name": "$F > S$", "f": 1 },
                  { "name": "Longer-term futures contract > nearer-term futures contract" }
                ]
              },
              {
                "name": "Backwardation",
                "children": [
                  { "name": "$F < S$", "f": 1 },
                  { "name": "Longer-term futures contract < nearer-term futures contract" }
                ]
              }
            ]
          },
          {
            "name": "Theories of futures return",
            "children": [
              {
                "name": "Insurance theory",
                "children": [
                  { "name": "Producers sell forward to lock the price" },
                  { "name": "Normal backwardation", "trap": 1 }
                ]
              },
              {
                "name": "Hedging pressure theory",
                "children": [
                  { "name": "Two forces of seeking price protection are equal → flat commodity curve" },
                  { "name": "Producers more interested in selling forward → backwardation" },
                  { "name": "Consumers more worried about price volatility → contango" }
                ]
              },
              {
                "name": "Theory of storage",
                "children": [
                  { "name": "If commodity is regularly stored → contango" },
                  { "name": "Just-in-time delivery and use → backwardation" },
                  { "name": "$F = S + \\text{direct storage cost} - \\text{convenience yield}$", "f": 1 }
                ]
              }
            ]
          },
          {
            "name": "Components of futures return",
            "children": [
              {
                "name": "Price return",
                "children": [
                  { "name": "Price return = (current price − previous price) / previous price", "f": 1 }
                ]
              },
              {
                "name": "Roll return",
                "children": [
                  { "name": "Roll return = [(near-term futures − farther-term futures) / near-term futures] × % of position", "f": 1 },
                  { "name": "Long position: backwardation → positive roll return", "trap": 1 },
                  { "name": "Long position: contango → negative roll return", "trap": 1 }
                ]
              },
              { "name": "Collateral return" },
              { "name": "Rebalance return (index only)" }
            ]
          },
          {
            "name": "Commodity swaps",
            "children": [
              { "name": "Excess return swap: changes in index level relative to a benchmark or fixed level" },
              { "name": "Total return swap: change in index level × notional amount" },
              { "name": "Basis swap: two related commodity reference prices that are not perfectly correlated" },
              { "name": "Volatility (variance) swap: proportional difference between actual variance and fixed variance at outset" }
            ]
          },
