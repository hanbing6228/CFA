              {
                "name": "Relative approach",
                "children": [
                  {
                    "name": "FFO",
                    "children": [
                      { "name": "FFO = NI −/(+) gains(losses) from sales of properties + depreciation and amortization + impairments and write-downs unrelated to depreciation", "f": 1 },
