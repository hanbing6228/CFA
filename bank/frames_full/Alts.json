                "name": "NAVPS approach",
                "children": [
                  { "name": "Remove non-cash rents" },
                  { "name": "NAV = (Cash NOI / cap rate) + tangible asset − liability", "f": 1 },
                  { "name": "NAVPS = NAV / shares outstanding", "f": 1 }
