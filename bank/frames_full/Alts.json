                  {
                    "name": "AFFO",
                    "children": [
                      { "name": "AFFO = FFO − non-cash rent − maintenance-type capital expenditure − leasing cost", "f": 1 },
                      { "name": "More accurate measure of current economic income" },
                      { "name": "P/AFFO" },
                      { "name": "Reflective of a REIT's dividend-paying ability" },
                      { "name": "More variation and error", "trap": 1 }
