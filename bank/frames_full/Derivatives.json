       {
        "name": "Carry arbitrage model",
        "children": [
         {
          "name": "Carry arbitrage",
          "children": [
           {
            "name": "Foward contract market price is too high",
            "children": [
             {
              "name": "At initiation",
              "children": [
               {
                "name": "Step 1 Sell the forward contract"
               },
               {
                "name": "Step 2 Borrow funds at the risk-free rate"
               },
               {
                "name": "Step 3 Purchase the underlying"
               }
              ]
             },
             {
              "name": "At settlement date",
              "children": [
               {
                "name": "Step 1 Deliver the underlying to the long"
               },
               {
                "name": "Step 2 Get the payment from the long"
               },
               {
                "name": "Step 3 Repay the loan"
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "name": "Reverse carry arbitrage",
          "children": [
           {
            "name": "Forward contract market price is too low",
            "children": [
             {
              "name": "At initiation",
              "children": [
               {
                "name": "Step 1 Buy the forward contract"
               },
               {
                "name": "Step 2 Short sell the underlying"
               },
               {
                "name": "Step 3 Lend the short sale proceeds"
               }
              ]
             },
             {
              "name": "At settlement date",
              "children": [
               {
                "name": "Step 1 Pay the forward price and get the unerlying"
               },
               {
                "name": "Step 2 Close out the short position by delivering the underlying"
               },
               {
                "name": "Step 3 Receive investment proceeds"
               }
              ]
             }
            ]
           }
          ]
