       {
        "name": "Interest rate forward/futures",
        "children": [
         {
          "name": "FRA",
          "children": [
           {
            "name": "Basic concepts",
            "children": [
             {
              "name": "Libor"
             },
             {
              "name": "No loan is actually made, just an interest payment and always settled in cash at contract expiration"
             },
             {
              "name": "Advanced set"
             },
             {
              "name": "Payment"
             },
             {
              "name": "Annualized based on a 360-day year, add-on rate"
             },
             {
              "name": "Settled in arrears"
             },
             {
              "name": "Advanded settled"
             },
             {
              "name": "Payment is made at the maturity of the underlying instrument"
             },
             {
              "name": "FRA expires and settle at the same time"
             },
             {
              "name": "Reference rate at the expiration date is above the contract rate, the long will receive cash payment"
             },
             {
              "name": "Reference rate at the expiration date is below the contract rate, the short will receive cash payment"
             }
            ]
           },
           {
            "name": "Pricing",
            "children": [
             {
              "name": "Forward price in an FRA is the no-arbitrage forward rate",
              "f": 1
             }
            ]
           },
           {
            "name": "Valuation",
            "children": [
             {
              "name": "At maturity"
             },
             {
              "name": "Before maturity",
              "children": [
               {
                "name": "Find the new FRA price first"
               },
               {
                "name": "The futures value is zero after marketing to market",
                "trap": 1
               },
               {
                "name": "The forward value is the present value of the difference in forward prices at an intermediate time"
               }
              ]
             }
            ]
           }
          ]
         }
        ]
