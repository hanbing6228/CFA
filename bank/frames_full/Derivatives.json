         {
          "name": "Bond futures",
          "children": [
           {
            "name": "Concept",
            "children": [
             {
              "name": "Accrual interest = (days since coupon payments / days between coupon payments)× coupon amounts",
              "f": 1
             },
             {
              "name": "Full price = clean price + accrued interest",
              "f": 1
             },
             {
              "name": "Conversion factor"
             },
             {
              "name": "Cheapest-to-deliver",
              "children": [
               {
                "name": "The debt instrument that can be purchased and delivered at the lowest cost"
               }
              ]
             },
             {
              "name": "S=Quoted bond price + accrued interest",
              "f": 1
             }
            ]
           },
           {
