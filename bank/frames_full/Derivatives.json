       {
        "name": "Convergence",
        "children": [
         {
          "name": "At time T, both forward/future prices = spot price"
         }
        ]
       },
       {
        "name": "No-arbitrage principle",
        "children": [
         {
          "name": "Tradable securities with identical cash flow payments must have the same price"
