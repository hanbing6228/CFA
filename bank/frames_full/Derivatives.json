       {
        "name": "Equity swap",
        "children": [
         {
          "name": "Basic concept",
          "children": [
           {
            "name": "One party pays cash ﬂow series determined by an equity"
           },
           {
            "name": "The other party",
            "children": [
             {
              "name": "Pays cash ﬂow series determined by another equity"
             },
             {
              "name": "Pays a ﬁxed series"
             }
            ]
           }
          ]
         },
         {
          "name": "Three types",
          "children": [
           {
            "name": "Receive-equity return, pay-ﬁxed",
            "children": [
             {
              "name": "Notional amount ×（Equity return - ﬁxed rate)",
              "f": 1
             }
            ]
           },
           {
            "name": "Receive-equity return, pay-ﬂoating",
            "children": [
             {
              "name": "Notional amount ×（Equity return - ﬂoating rate)",
              "f": 1
             }
            ]
           },
           {
            "name": "Receive-equity return, pay-another equity return",
            "children": [
             {
              "name": "Notional amount × (Equity return a - ﬂoating rate b)",
              "f": 1
             }
            ]
           }
          ]
         }
        ]
