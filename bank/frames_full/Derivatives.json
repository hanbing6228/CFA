         {
          "name": "Interest rate swap (Plain vanilla swap)",
          "children": [
           {
            "name": "Basic concept",
            "children": [
             {
              "name": "One party pays a ﬁxed rate and the other pays a ﬂoating rate"
             }
            ]
           },
           {
            "name": "Pricing",
            "children": [
             {
              "name": "Calculate the ﬁxed rate (swap rate) that makes the contract value zero at initiation"
             },
             {
              "name": "Swap rate=annualized periodic rate(C)",
              "f": 1
             },
             {
              "name": "B is the discount factor"
             }
            ]
           },
           {
            "name": "Valuing",
            "children": [
             {
              "name": "Receiver of a ﬁxed rate and payer of a ﬂoating rate",
              "children": [
               {
                "name": "V=Value of ﬁxed bond - value of ﬂoating bond",
                "f": 1
               }
              ]
             },
             {
              "name": "Receiver of a ﬂoating rate and payer of a ﬁxed rate",
              "children": [
               {
                "name": "V=Value of ﬂoating bond - value of ﬁxed bond",
                "f": 1
               }
              ]
             }
            ]
           }
          ]
         }
