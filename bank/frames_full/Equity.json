{
 "topic": "Equity",
 "tree": {
  "name": "Equity",
  "children": [
   {
    "name": "LM1 Equity Valuation: Applications and Processes",
    "children": [
     {
      "name": "Definition of valuation",
      "children": [
       {
        "name": "分类",
        "children": [
         {
          "name": "Intrinsic value",
          "children": [
           {
            "name": "内在价值：对资产投资特性全面认识下的资产价值"
           },
           {
            "name": "alpha: 一种经过风险调整的超额收益"
           },
           {
            "name": "$V_E - P = (V - P) + (V_E - V)$",
            "f": 1
           },
           {
            "name": "估计的股价与市场价格的差异，即为期望获得的超额回报"
           }
          ]
         },
         {
          "name": "Going-concern value: 持续经营假设下的价值；估值模型基于此"
         },
         {
          "name": "Liquidation value: 公司破产，资产被单独出售时的价值"
         },
         {
          "name": "Fair market value: 熟悉情况的双方自愿交易的价格"
         },
         {
          "name": "Investment value: 对特定买家，考虑潜在协同效应后的价值"
         }
        ]
       },
       {
        "name": "辨析",
        "children": [
         {
          "name": "Liquidation value < intrinsic value ≈ fair market value < investment value",
          "trap": 1
         }
        ]
       }
      ]
     },
     {
      "name": "Valuation Applications",
      "children": [
