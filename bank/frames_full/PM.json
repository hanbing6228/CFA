   {
    "name": "Measuring and Managing Market Risk",
    "children": [
     {
      "name": "Value at Risk",
      "children": [
       {
        "name": "Definition",
        "children": [
         {
          "name": "VaR states at some significance level (often 1 % or 5%) the minimum loss during a specified time period"
         },
         {
          "name": "衡量VaR的因素",
          "children": [
           {
            "name": "Probability：概率/显著性水平"
           },
           {
            "name": "Time period：时间期限"
           },
           {
            "name": "Distributions of portfolio's return：收益率分布"
           }
          ]
         }
        ]
       },
       {
        "name": "Dual interpretation",
        "children": [
         {
          "name": "左侧对应小概率和最小损失（minimum or at least）"
         },
         {
          "name": "右侧对应大概率和最大损失（maximum or no more than）"
         }
        ]
       },
       {
        "name": "Estimating Method",
        "children": [
         {
          "name": "Analytical method",
          "children": [
           {
            "name": "计算",
            "children": [
             {
              "name": "基于正态分布假设和计算左尾置信区间"
             },
             {
              "name": "Adjustment for different period",
              "children": [
               {
                "name": "标准差调整需要遵循平方根法则"
               }
              ]
             }
            ]
           },
           {
            "name": "优缺点",
            "children": [
             {
              "name": "优点",
              "children": [
               {
                "name": "作为一个数字，易于计算，易于理解"
               },
               {
                "name": "允许对风险的相关性进行建模"
               }
              ]
             },
             {
              "name": "缺点",
              "children": [
               {
                "name": "假设收益率的正态分布"
               },
               {
                "name": "很大的投资组合难以估算标准差，即组合中资产过多，导致两两之间的协方差矩阵计算量巨大"
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "name": "Historical method",
          "children": [
           {
            "name": "优点",
            "children": [
             {
              "name": "非常容易计算和理解"
             },
             {
              "name": "不需要假设收益率的分布"
             }
            ]
           },
           {
            "name": "缺点",
            "children": [
             {
              "name": "假设历史收益的模式在未来将会重复"
             }
            ]
           }
          ]
         },
         {
          "name": "Monte Carlo method",
          "children": [
           {
            "name": "优点",
            "children": [
             {
              "name": "适用于任意的分布假设"
             }
            ]
           },
           {
            "name": "缺点",
            "children": [
             {
              "name": "GIGO"
             },
             {
              "name": "模型的复杂性可能会导致对结果准确性的过度自信"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "name": "VaR本身的优缺点",
        "children": [
         {
          "name": "主要优点",
          "children": [
           {
            "name": "Simple concept"
           },
           {
            "name": "Easily communicated concept"
           },
           {
            "name": "Facilitates capital allocation decisions：促进资本配置决策，例如，某个部门的VaR值大，则应该配置更多的资本用于抵御风险"
           },
           {
            "name": "Widely accepted by regulators"
           }
          ]
         },
         {
          "name": "主要缺点",
          "children": [
           {
            "name": "Subjectivity：显著性水平的选择具有主观性"
           },
           {
            "name": "Underestimating the frequency of extreme events"
           },
           {
            "name": "没有考虑到流动性（可能发生流动性差导致 无法变现止损）"
           },
           {
            "name": "Vulnerability to trending or volatility regimes：易受趋势或波动机制的影响",
            "children": [
             {
              "name": "可能实际波动性和估计的波动性不符"
             }
            ]
           },
           {
            "name": "Oversimplification：过于简单（实务中左尾可能不服从正态分布）"
           },
           {
            "name": "Disregard of right-tail events：忽略右尾事件"
           }
          ]
         }
        ]
       },
       {
        "name": "Extensions of VaR",
        "children": [
         {
          "name": "Conditional VaR",
          "children": [
           {
            "name": "如果超出VaR临界值，产生的（算数）平均损失"
           },
           {
            "name": "CVaR>VaR",
            "f": 1
           }
          ]
         },
         {
          "name": "Incremental VaR",
          "children": [
           {
            "name": "头寸规模相对于剩余头寸发生变化，VaR值发生的变化"
           },
           {
            "name": "例如AB两个资产的VaR（AB），加入资产C后VaR（ABC），则IVaR=VaR（ABC）–VaR（AB）"
           }
          ]
         },
         {
          "name": "Marginal VaR",
          "children": [
           {
            "name": "概念上与增量风险价值相似"
           },
           {
            "name": "反映头寸很小变化的影响"
           },
           {
            "name": "资产每增加$1所带来的VaR值的增加(一阶导)"
           }
          ]
         },
         {
          "name": "relative VaR",
          "children": [
           {
            "name": "衡量给定投资组合的绩效可能偏离其基准的程度"
           },
           {
            "name": "Relative VaR = VaR（portfolio）–VaR（benchmark）",
            "f": 1
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "name": "Other key risk measures",
      "children": [
       {
        "name": "Sensitivity",
        "children": [
         {
          "name": "优点",
          "children": [
           {
            "name": "风险衡量工具和特定风险一一对应"
           }
          ]
         },
         {
          "name": "缺点",
          "children": [
           {
            "name": "只能衡量特定风险，缺乏通用性"
           }
          ]
         }
        ]
       },
       {
        "name": "Scenario risk measures",
        "children": [
         {
          "name": "分类",
          "children": [
           {
            "name": "Historical scenarios",
            "children": [
             {
              "name": "假设一个历史上真实出现过的情景"
             }
            ]
           },
           {
            "name": "Hypothetical scenarios",
            "children": [
             {
              "name": "假设一个历史上未出现过的情景"
             }
            ]
           }
          ]
         },
         {
          "name": "优点",
          "children": [
           {
            "name": "考虑到流动性（补充VaR的缺点）"
           },
           {
            "name": "不需要正态分布假设"
           },
           {
            "name": "不依赖历史数据"
           }
          ]
         },
         {
          "name": "缺点",
          "children": [
           {
            "name": "Historical scenarios",
            "children": [
             {
              "name": "历史情景不会以完全相同的方式再次发生"
             }
            ]
           },
           {
            "name": "Hypothetical scenarios",
            "children": [
             {
              "name": "难以模拟不同资产间的相互影响"
             },
             {
              "name": "难以建立适当的限制"
             },
             {
              "name": "很难模拟出真实的环境"
             }
            ]
           }
          ]
         }
        ]
