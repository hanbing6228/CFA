{
 "topic": "QM",
 "tree": {
  "name": "QM",
  "children": [
   {
    "name": "Machine Learning",
    "children": [
     {
      "name": "What is machine learning ?",
      "children": [
       {
        "name": "Defining machine learning",
        "children": [
         {
          "name": "The use of algorithms to make decisions by generalizing (or finding patterns) in a given dataset"
         }
        ]
       }
      ]
     },
     {
      "name": "Types of Machine Learning",
      "children": [
       {
        "name": "Supervised learning",
        "children": [
         {
          "name": "Use labeled training data to guide the ML program toward superior forecasting accuracy."
         },
         {
          "name": "Dependent variable is the target"
         },
         {
          "name": "Independent variables are features"
         },
         {
          "name": "Labeled data contains matched sets of observed inputs and the associated output."
         },
         {
          "name": "Two Categories",
          "children": [
           {
            "name": "Regression problems",
            "children": [
             {
              "name": "Making prediction of continuous target variables （OLS)"
             }
            ]
           },
           {
            "name": "Classification problems",
            "children": [
             {
              "name": "Sorting observations into distinct categories (binary,multi-category)"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "name": "Unsupervised learning",
        "children": [
         {
          "name": "Does not make use of labled data"
         },
         {
          "name": "Seek to discover structure within the data themselves."
         },
         {
          "name": "Two types",
          "children": [
           {
            "name": "Dimesion reduction",
            "children": [
             {
              "name": "Reducing the number of features while retaining variation across observations to preserve the information contained in that variation"
             }
            ]
           },
           {
            "name": "Clustering",
            "children": [
             {
              "name": "Sorting observations into groups (clusters) such that observations in the same cluster are more similar to each other than they are to observations in other clusters"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "name": "Deep learning&Reinforcement learning",
        "children": [
         {
          "name": "Deep learning",
          "children": [
           {
            "name": "Sophisticated algorithms address highly complex tasks"
           }
          ]
         },
         {
          "name": "Reinforcement learning",
          "children": [
           {
            "name": "Computer learns from interacting with itself"
           }
          ]
         },
         {
          "name": "Neural networks",
          "children": [
           {
            "name": "Foundation of deep learning and reinforcement learning"
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "name": "Evaluating ML algorithm performance",
      "children": [
       {
        "name": "Overfitting",
        "trap": 1,
        "children": [
         {
          "name": "ML algorithm that fits the training data too well will not predict well using new data"
         },
         {
          "name": "Three non-overlapping samples",
          "children": [
           {
            "name": "Training sample",
            "children": [
             {
              "name": "Train the model"
             }
            ]
           },
           {
            "name": "Validation sample",
            "children": [
             {
              "name": "Validating and tuning the model"
             }
            ]
           },
           {
            "name": "Test sample",
            "children": [
             {
              "name": "Testing the model's ability to predict well on new data"
             }
            ]
           }
          ]
         },
         {
          "name": "Total out-of-sample error",
          "children": [
           {
            "name": "Bias error",
            "children": [
             {
              "name": "Degree to which a model fits the training data, in-sample error"
             }
            ]
           },
           {
            "name": "Variance error",
            "children": [
             {
              "name": "How much the model's results change in response to new data from validation and test sample, out-of-sample error"
             }
            ]
           },
           {
            "name": "Base error",
            "children": [
             {
              "name": "Due to randomness in the data"
             }
            ]
           }
          ]
         },
         {
          "name": "Fitting curve",
          "children": [
           {
            "name": "Complexity",
            "children": [
             {
              "name": "Number of features,terms,or branches in the model. Linear&Non-linear"
             }
            ]
           },
           {
            "name": "Compexity increase in the training set",
            "children": [
             {
              "name": "Error rates fall and bias error shrinks"
             }
            ]
           },
           {
            "name": "Complexity increase in the test set",
            "children": [
             {
              "name": "Error rates rise and variance error rise"
             }
            ]
           },
           {
            "name": "Optimal point of complexity",
            "children": [
             {
              "name": "Bias and Variance error curve intersect"
             },
             {
              "name": "In-and out-of-sample error rates are minimized"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "name": "Preventing overfitting",
        "children": [
         {
          "name": "Penalizing algorithms that are too complex or too flexible"
         },
         {
          "name": "Cross-validation",
          "children": [
           {
            "name": "Out-of-sample error is estimated directly by determining the error in validation samples"
           },
           {
            "name": "k-fold cross validation",
            "children": [
             {
              "name": "Mitigate holdout samples （data samples not used to train the model）"
             }
            ]
           }
          ]
         },
         {
          "name": "Generalization",
          "children": [
           {
            "name": "A model retains its explanatory power when predicting out-of-sample"
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "name": "Supervised learning",
      "children": [
       {
        "name": "Penalized regression（prediction problem）",
        "children": [
         {
          "name": "Reduce the problem of overfitting by imposing a penalty term"
         },
         {
          "name": "LASSO",
          "children": [
           {
            "name": "λ is a hyperparameter"
           }
          ]
         },
         {
          "name": "Regularization",
          "children": [
           {
            "name": "Describe methods that reduce statistical variability in high dimensional data estimation problems"
           },
           {
            "name": "Can be applied to non-linear models"
           }
          ]
         }
        ]
       },
       {
        "name": "Support vector machine（classification, regression, outlier detection）",
        "children": [
         {
          "name": "Linear classifier that determines the hyperplane that optimally separates the observations into two possible classifiers"
         },
         {
          "name": "Maximizes the probability of making a correct prediction by determining the boundary that is farthest away from all the observations"
         },
         {
          "name": "Soft margin classification",
          "children": [
           {
            "name": "Adds a penalty to the objective function for observations in the training set that are misclassified"
           }
          ]
         }
        ]
       },
       {
        "name": "K-nearest neighbor （classification&regression)",
        "children": [
         {
          "name": "Classify a new observation by finding similarities (“nearness”) between this new observation and the training sample"
         },
         {
          "name": "K is a hyperparameter"
         },
         {
          "name": "K is too small",
          "children": [
           {
            "name": "High error rate"
           }
          ]
         },
         {
          "name": "K is too large",
          "children": [
           {
            "name": "Dilute the result by averaging across too many outcomes."
           }
          ]
         },
         {
          "name": "K is even",
          "children": [
           {
            "name": "No clear winner"
           }
          ]
         },
         {
          "name": "Non-parametric,makes no assumption about the distribution of the data."
         }
        ]
       },
       {
        "name": "CART（binary classification&regression）",
        "children": [
         {
          "name": "Provides a visual explanation"
         },
         {
          "name": "Avoid overfitting",
          "children": [
           {
            "name": "Add regularization parameters"
           },
           {
            "name": "Sections of tree with minimal explanatory power are pruned."
           }
          ]
         },
         {
          "name": "Investment applications of CART include selecting stocks and bonds and enhancing detection of fraud in financial statements"
         }
        ]
       },
       {
        "name": "Ensemble learning and random forests",
        "children": [
         {
          "name": "Ensembled learning",
          "children": [
           {
            "name": "Combining the predictions from a collection of models"
           },
           {
            "name": "Aggregation of homogeneous learners",
            "children": [
             {
              "name": "Bootstrap aggregating（bagging）",
              "children": [
               {
                "name": "Original training data set is used to generate n new training data sets or bags of data"
               }
              ]
             }
            ]
           },
           {
            "name": "Aggregation of heterogeneous learners",
            "children": [
             {
              "name": "Voting classifier",
              "children": [
               {
                "name": "Assign to a new data point the predicted label with the most votes"
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "name": "Random forest",
          "children": [
           {
            "name": "A variant of classification trees whereby a large number of classification trees are trained using data bagged from the same data set"
           },
           {
            "name": "Investment applications of random forest include factor-based asset allocation, and prediction models for the success of an IPO"
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "name": "Unsupervised learning",
      "children": [
       {
        "name": "Dimenson reduction",
        "children": [
         {
          "name": "Principal components analysis",
          "children": [
           {
            "name": "PCA is used to summarize or reduce highly correlated features of data into a few main, uncorrelated composite variables"
           },
           {
            "name": "Eigenvectors",
            "children": [
             {
              "name": "Linear combinations of the original features"
             }
            ]
           },
           {
            "name": "Eigenvalue",
            "children": [
             {
              "name": "The proportion of total variance in the initial data explained by each eigenvector"
             }
            ]
           },
           {
            "name": "Drawbacks",
            "trap": 1,
            "children": [
             {
              "name": "Principal components cannot be easily labeled or directly interpreted by the analyst"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "name": "Clustering",
        "children": [
         {
          "name": "K-means clustering",
          "children": [
           {
            "name": "Clustering partitions observations into k non-overlapping clusters, where k is a hyperparameter"
           },
           {
            "name": "Clustering is used in investment management to classify thousands of securities based on patterns in high dimensional data"
           }
          ]
         },
         {
          "name": "Hierarchical clustering",
          "children": [
           {
            "name": "Builds a hierarchy of clusters without any predefined number of clusters"
           },
           {
            "name": "Agglomerative (or bottom-up) clustering",
            "children": [
             {
              "name": "Begins with each observation being treated as its own cluster"
             }
            ]
           },
           {
            "name": "Divisive (or top-down) clustering",
            "children": [
             {
              "name": "Starts with all the observations belonging to a single cluster"
             }
            ]
           },
           {
            "name": "Can be used in investment management for diversification and analysis of portfolio risk"
           },
           {
            "name": "Dendrogram",
            "children": [
             {
              "name": "A type of tree diagram for visualizing a hierarchical cluster analysis"
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "name": "Neural networks, Deep neural networks, and reinforcement learning",
      "children": [
       {
        "name": "Neural networks",
        "children": [
         {
          "name": "Three layer",
          "children": [
           {
            "name": "Input layer"
           },
           {
            "name": "Hidden layer"
           },
           {
            "name": "Output layer"
           }
          ]
         },
         {
          "name": "Forward propogation"
         },
         {
          "name": "Backward propagation",
          "children": [
           {
            "name": "根据结果，调整input node的权重和偏置项"
           }
          ]
         }
        ]
       },
       {
        "name": "Deep neural networks",
        "children": [
         {
          "name": "Neural networks with many hidden layers"
         }
        ]
       },
       {
        "name": "Reinforcement learning",
        "children": [
         {
          "name": "Have an agent that seeks to maximize a defined reward given defined constraints"
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}