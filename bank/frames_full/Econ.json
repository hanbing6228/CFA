     {
      "name": "International parity conditions",
      "children": [
       {
        "name": "Interest rate parity",
        "children": [
         {
          "name": "Covered interest rate parity",
          "trap": 1,
          "children": [
           {
            "name": "Covered interest arbitrage",
            "children": [
             {
              "name": "If F/S > (1+rx)/(1+ry)",
              "f": 1,
              "children": [
               {
                "name": "Profit= F/S × (1+ry) − (1+rx)",
                "f": 1
               }
              ]
             },
             {
              "name": "If F/S < (1+rx)/(1+ry)",
              "f": 1,
              "children": [
               {
                "name": "Profit= S/F × (1+rx) − (1+ry)",
                "f": 1
               }
              ]
             }
            ]
           },
           {
            "name": "F(f/d) = S(f/d) × [1 + if(Actual/360)] / [1 + id(Actual/360)]",
            "f": 1,
            "children": [
             {
              "name": "Interest differential =forward differential"
             }
            ]
           }
          ]
         },
         {
          "name": "Uncovered interest rate parity",
          "trap": 1,
          "children": [
           {
            "name": "短、中期不成立，长期可能成立"
           },
           {
            "name": "E(St)/S0 = (1+rx)/(1+ry)",
            "f": 1,
            "children": [
             {
              "name": "%ΔS^e_(f/d) = if − id",
              "f": 1
             }
            ]
           }
          ]
         },
         {
          "name": "Forward rate parity",
          "children": [
           {
            "name": "(F − S0)/S0 = E(%ΔS)",
            "f": 1,
            "children": [
             {
              "name": "Both covered and uncovered interest rate parity hold"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "name": "Purchasing power parity",
        "children": [
         {
          "name": "Law of one price",
          "children": [
           {
            "name": "Absolute version of PPP"
           }
          ]
         },
         {
          "name": "Relative version of PPP",
          "trap": 1,
          "children": [
           {
            "name": "St/S0 = [(1+πX)/(1+πY)]^t",
            "f": 1,
            "children": [
             {
              "name": "%ΔS_(X/Y) ≅ πX − πY",
              "f": 1
             }
            ]
           }
          ]
         },
         {
          "name": "Ex ante version of PPP",
          "trap": 1,
          "children": [
           {
            "name": "E(St)/S0 = (1+π^e_X)/(1+π^e_Y)",
            "f": 1,
            "children": [
             {
              "name": "%ΔS^e_(X/Y) ≅ π^e_X − π^e_Y",
              "f": 1
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "name": "International Fisher relation",
        "trap": 1,
        "children": [
         {
          "name": "Fisher effect",
          "children": [
           {
            "name": "r^N_X = r^R_X + π^e_X",
            "f": 1
           }
          ]
         },
         {
          "name": "当UIRP和ex ante PPP都成立",
          "children": [
           {
            "name": "Real interest rate parity",
            "children": [
             {
              "name": "r^N_X − r^N_Y = π^e_X − π^e_Y",
              "f": 1
             }
            ]
           }
          ]
         }
        ]
       }
